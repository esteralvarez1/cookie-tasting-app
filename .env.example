# ─── Frontend / Vite ────────────────────────────────────────────────────────

# URL del backend tal como lo ve el navegador.


# Desarrollo local:
# VITE_API_BASE_URL=http://127.0.0.1:8000


# Producción:
# VITE_API_BASE_URL=https://URL-DEL-BACKEND

VITE_API_BASE_URL=http://127.0.0.1:8000

# Clave usada por el frontend para acceder al panel/admin si aplica.

# IMPORTANTE:
# Las variables VITE_ son públicas en el navegador.
# No usar aquí una clave secreta crítica.

VITE_ADMIN_API_KEY=change-me

# ─── Docker Compose producción ──────────────────────────────────────────────

# URL pública de la aplicación (IP o dominio de la VM).
# Usada por docker-compose.prod.yml como VITE_API_BASE_URL al compilar el frontend.
PUBLIC_APP_URL=http://IP-DE-LA-VM

# ─── Backend ────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production

APP_ENV=development

# Nivel de logs: DEBUG | INFO | WARNING | ERROR

LOG_LEVEL=INFO

# Credenciales de PostgreSQL.
# En producción con docker-compose.prod.yml, DATABASE_URL se construye
# automáticamente a partir de estas tres variables; no es necesario repetirla.

POSTGRES_DB=cookie_tasting
POSTGRES_USER=cookie_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# URL de conexión a PostgreSQL.

#

# Desarrollo local con Docker:

# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cookie_tasting

#

# Producción:

# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cookie_tasting

# ─── LLM ────────────────────────────────────────────────────────────────────

# Proveedor del LLM:

# rules              → reglas locales, sin llamadas externas

# openai-compatible  → API compatible con OpenAI, por ejemplo vLLM

# groq               → Groq

# openai             → OpenAI

# ollama             → Ollama local

LLM_PROVIDER=rules

# ---- URL base del proveedor LLM.------

# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1

# vLLM con API compatible OpenAI:
# LLM_BASE_URL=https://URL-DEL-SERVIDOR/v1

# Ollama local:
# LLM_BASE_URL=http://localhost:11434

LLM_BASE_URL=https://api.groq.com/openai/v1

# Clave API del proveedor LLM.

# No poner claves reales en .env.example.

LLM_API_KEY=

# Modelo usado por el LLM.Ejemplos:
# LLM_MODEL=llama-3.1-8b-instant
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_SECONDS=20
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_RESPONSE_FORMAT_JSON=true
LLM_CONTEXT_MAX_CHARS=3000
LLM_CONTEXT_MODE=minimal

# Fallback automático a reglas si falla el LLM.

#

# false recomendado para producción y validación final:

# - Si falla el LLM, se ve el error claramente.

#

# true útil en desarrollo:

# - Si falla el LLM, la aplicación usa reglas locales.

LLM_FALLBACK_TO_RULES=false

# ─── Seguridad / Administración ─────────────────────────────────────────────

# Claves internas para endpoints protegidos.

# Cambiar siempre en producción.

ADMIN_API_KEY=change-me
RESEARCHER_API_KEY=change-me-researcher

# Orígenes permitidos para CORS.

#

# Desarrollo local:

# BACKEND_CORS_ORIGINS=http://localhost:5173

#

# Producción:

# BACKEND_CORS_ORIGINS=https://URL-DEL-FRONTEND

#

# Si se permiten varios orígenes, usar el formato que soporte tu Settings.

# Ejemplo con varios orígenes (separados por comas, sin corchetes):
# BACKEND_CORS_ORIGINS=http://localhost:5173,https://URL-DEL-FRONTEND
BACKEND_CORS_ORIGINS=http://localhost:5173

# ─── Sesiones ───────────────────────────────────────────────────────────────

# Tiempo de validez del token de sesión del participante.

SESSION_TOKEN_TTL_HOURS=24

# ─── Reintentos del flujo conversacional ────────────────────────────────────

MAX_VAGUE_RETRIES=1
MAX_COMPARISON_RETRIES=2
MAX_MODALITY_ATTEMPTS=2

# ─── Rate limiting ──────────────────────────────────────────────────────────

RATE_LIMIT_SESSIONS_PER_MINUTE=10
RATE_LIMIT_DIALOG_PER_MINUTE=30

# ─── Despliegue UPM: Salamandra local (servicio interno salamandra-api) ──────
#
# Configuración objetivo para la VM de la UPM (CPU, sin GPU, sin APIs externas).
# El backend habla con el servicio interno salamandra-api usando la interfaz
# OpenAI-compatible que ya sabe consumir. Copia estas variables en tu .env.prod.
#
# Con estos valores el backend deja de usar Groq y usa el modelo local:
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://salamandra-api:8001/v1
LLM_MODEL=local-salamandra-2b-instruct
LLM_API_KEY=REEMPLAZAR_SALAMANDRA_API_KEY_INTERNA

# Fallback a reglas activado (recomendado con un 2B en CPU).
# LLM_FALLBACK_ENABLED es un alias de LLM_FALLBACK_TO_RULES; ambos valen.
LLM_FALLBACK_ENABLED=true
# El modelo local no garantiza response_format JSON: se desactiva.
LLM_RESPONSE_FORMAT_JSON=false
# Timeouts amplios: la inferencia en CPU es lenta.
LLM_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1
LLM_CONTEXT_MODE=minimal
LLM_CONTEXT_MAX_CHARS=2500

# Variables propias del servicio interno salamandra-api.
# La clave debe coincidir con LLM_API_KEY (el backend la envía como Bearer token).
SALAMANDRA_API_KEY=REEMPLAZAR_SALAMANDRA_API_KEY_INTERNA
SALAMANDRA_MODEL_PATH=/models/salamandra-2b-instruct
SALAMANDRA_MAX_NEW_TOKENS=700
